    "i1_body": {
      "type": "Text",
      "props": {
        "text": "Attacker used an employee's GitHub account to push malicious code to backend services, which pulled account records (names, emails, IDs, public keys, SRP parameters) for a subset of customers. Some invitation and recovery tokens were included. 1Password says vault contents were not accessed.",
        "variant": "body"
      },
      "children": []
    },
    "i1_why": {
      "type": "Text",
      "props": {
        "text": "Why it matters: expect phishing that mentions 1Password invitations or account recovery; the CI/CD secrets exposure is worth watching for follow-up.",
        "variant": "muted"
      },
      "children": []
    },
